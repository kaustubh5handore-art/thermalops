# Copy this file to .env and fill in your real hackathon key.
# app.py loads .env automatically via python-dotenv if present.

# Your FortyGuard Hackathon'26 trial API key (2,000,000 credits / 5 weeks).
# Leave blank to run in mock mode — the app works fully without a key.
FORTYGUARD_API_KEY=

# Usually shouldn't need to change these:
FORTYGUARD_API_BASE=https://api.fortyguard.com
FORTYGUARD_SUBMIT_PATH=/v1/env_params
FORTYGUARD_STATUS_PATH_TEMPLATE=/v1/env_params/{activity_id}

# How often the background loop re-polls every site, in seconds.
REFRESH_INTERVAL_SECONDS=60

# Flask
PORT=5000
FLASK_DEBUG=0
